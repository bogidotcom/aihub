# /opt/thermopolium/server/.env  (chmod 600 — this file holds secrets, deploy.sh never overwrites it)

PORT=3460
# SQLite lives outside the code tree so `rsync --delete` can never touch it.
DB_PATH=/var/lib/thermopolium/thermopolium.db

# ---- Telegram (login widget, admin alerts, RSVP bot) ----
BOT_TOKEN=
# BotFather → /setdomain → iamai.kg   (the Login Widget refuses any other domain)
WEB_APP_URL=https://iamai.kg/thermopolium
# usernames (no @) that become admins on /start; they receive project submissions
ADMIN_USERNAMES=
ADMIN_API_TOKEN=

# ---- $THERM: Solana → memo → signed DAI job ----
# Empty mint/treasury = watcher idle; the site, feed and top 10 still work. Fill these in at token launch.
THERM_MINT=
# Wallet ADDRESS that receives THERM (the watcher only needs the public address).
THERM_TREASURY=
# Use a dedicated RPC (Helius, Triton, QuickNode…) — the public endpoint rate-limits a 8s poll.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# 1 THERM buys this many AI tokens (1 token = 1 μDAI at the default gas price).
THERM_TOKENS_PER_THERM=100000000
# Hard cap on what one prompt may spend, in AI tokens. 20,000,000 = 0.02 DAI.
THERM_MAX_JOB_TOKENS=20000000
# First start does NOT answer historical transfers (it would spend DAI on old memos). Set 1 to replay up to 200.
THERM_BACKFILL=0

# ---- DAI wallet that pays for the jobs (prefund it with DAI) ----
DAI_NODE_URL=http://127.0.0.1:3456
# Create:   node dai-wallet.mjs generate /opt/thermopolium/dai-signing.pem
# Register: node dai-wallet.mjs register        (once)     Check: node dai-wallet.mjs status
DAI_SIGNING_KEY_FILE=/opt/thermopolium/dai-signing.pem
# Optional: only if the wallet was registered under an address other than the key-derived one.
DAI_ADDRESS=
# Optional: model for the compute jobs (defaults to the node's own model).
DAI_JOB_MODEL=

# ---- payments inherited from the app (ticket flows; unused by the free Thermopolium ticket) ----
TON_ADDRESS=
TRC20_ADDRESS=
SOL_ADDRESS=
ERC20_ADDRESS=
USDT_JETTON=
TONCENTER_KEY=
WATCH_INTERVAL_MS=20000
